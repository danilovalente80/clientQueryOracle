<?xml version="1.0" encoding="UTF-8"?>
<application xmlns="http://java.sun.com/xml/ns/javaee"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
             http://java.sun.com/xml/ns/javaee/application_6.xsd"
             version="6">

    <description>Java EE application for executing Oracle queries with transaction management</description>
    <display-name>Oracle Query Client Application</display-name>
    <application-name>clientQueryOracle</application-name>

    <module>
        <ejb>clientQueryOracle-ejb-1.0.0.jar</ejb>
    </module>

    <module>
        <web>
            <web-uri>clientQueryOracle-web-1.0.0.war</web-uri>
            <context-root>/queryOracle</context-root>
        </web>
    </module>

</application>
